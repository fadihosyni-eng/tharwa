---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import favicon from '../../../public/brand/favicon.png?url';
import ogImage from '../../../public/brand/serva-logo-512.webp?url';

interface Props {
  title?: string;
  description?: string;
  active?: 'home' | 'games' | 'store' | 'leaders' | '';
  noindex?: boolean;
  canonical?: boolean;
  bodyClass?: string;
}
const {
  title,
  description = 'ثروة — منصة ألعاب أونلاين من Serva: العب «ثروة» لعبة المدن والعقارات العربية مع أصحابك، اجمع نقاط وتصدّر القائمة.',
  active = '',
  noindex = false,
  canonical = true,
  bodyClass = '',
} = Astro.props;
const fullTitle = title ? `${title} — ثروة` : 'ثروة — ألعاب أونلاين من Serva';
const site = Astro.site ?? new URL('https://tharwa.onrender.com');
const pageUrl = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), site).href;
const ogUrl = new URL(ogImage, site).href;
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={pageUrl} />}
    <meta name="theme-color" content="#030816" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/png" href={favicon} />
    <link rel="apple-touch-icon" href={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ثروة" />
    <meta property="og:locale" content="ar_AR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class={bodyClass || undefined}>
    <a class="skip" href="#main">تخطّى للمحتوى</a>
    <Header active={active} />
    <main id="main" class="wrap page">
      <slot />
    </main>
    <Footer />
    <div id="modal-root"></div>
    <div id="toasts" aria-live="polite"></div>
  </body>
</html>
