---
import Base from '../layouts/Base.astro';
import { ui } from '../lib/art-build';
---
<Base title="مو موجود" noindex canonical={false}>
  <div class="panel nf404">
    <div class="code">404</div>
    <h1>الصفحة مو موجودة</h1>
    <p>يمكن الرابط غلط أو انمسح.</p>
    <a class="btn btn-gold" href="/"><Fragment set:html={ui('house')} />ارجع للصفحة الرئيسية</a>
  </div>
</Base>
<style>
  .nf404 { text-align: center; padding: 56px 20px; max-width: 560px; margin: 30px auto 0; }
  .code { font-size: 96px; font-weight: 900; color: var(--cyan2); line-height: 1; text-shadow: 0 0 30px rgba(0, 180, 255, .5); }
  h1 { margin: 12px 0 6px; font-size: 26px; }
  p { color: var(--muted); margin: 0 0 22px; }
</style>
