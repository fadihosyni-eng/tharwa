---
import Base from '../layouts/Base.astro';
import { ui, diceHTML } from '../lib/art-build';
import { icon } from '../components/icons';
import { CATALOG } from '../components/games/catalog';

const hero = CATALOG[0];
const side = CATALOG.slice(1, 3);
const TRUST = [
  { ico: icon('nodownload'), text: 'بلا تنزيل' },
  { ico: icon('devices'), text: 'عالموبايل والكمبيوتر' },
  { ico: icon('gift'), text: 'ببلاش' },
];
const STEPS = [
  { ico: ui('gamepad'), title: 'اختار لعبة', text: 'من المكتبة — لعبة سريعة لتنين أو لعبة جماعية لكل الشلّة.' },
  { ico: icon('link'), title: 'ابعت الرابط لصحابك', text: 'اعمل غرفة وابعت الرابط أو الكود، أو العب ضد الكمبيوتر.' },
  { ico: ui('trophy'), title: 'العبوا', text: 'كل لعبة وكل فوز بيجمعلك نقاط لتطلع على قائمة المتصدرين.' },
];
const CATS = [
  { key: 'duo', label: 'لتنين', ico: ui('users') },
  { key: 'party', label: 'جماعية', ico: ui('party') },
  { key: 'bots', label: 'ضد الكمبيوتر', ico: ui('robot') },
  { key: 'cards', label: 'ورق الشدة', ico: ui('cards'), hidden: true },
];
---
<Base active="home" description="Serva Games — منصة ألعاب أونلاين من Serva. العب مع صحابك من المتصفح بلا تنزيل: اعمل غرفة، ابعت الكود، أو العب ضد الكمبيوتر. اجمع نقاط وتصدّر القائمة.">
  <div class="ad-wrap" data-ad="home_top" hidden></div>

  <!-- hero -->
  <section class="hero" aria-labelledby="heroTitle">
    <div class="hero-text">
      <span class="eyebrow"><Fragment set:html={ui('sparkle')} />منصة ألعاب أونلاين من Serva</span>
      <h1 id="heroTitle">العب مع صحابك<br /><span class="grad">بلا تنزيل</span></h1>
      <p class="lead">ألعاب جماعية بتنلعب من المتصفح: اعمل غرفة وابعت الرابط لصحابك، أو تحدّى الكمبيوتر إذا ما حدا فاضي.</p>
      <div class="hero-cta">
        <a class="btn btn-gold big" href="/games"><Fragment set:html={ui('play')} />العب هلّق</a>
        <button class="btn big btn-ghost" type="button" id="codeBtn"><Fragment set:html={ui('key')} />عندي كود غرفة</button>
      </div>
      <ul class="trust" aria-label="ليش Serva Games">
        {TRUST.map((t) => <li><Fragment set:html={t.ico} />{t.text}</li>)}
      </ul>
      <p class="hero-live" id="heroLive" hidden><span class="live-dot"></span><span></span></p>
    </div>

    <div class="stage" aria-hidden="true">
      <div class="stage-glow"></div>
      {side.map((g, i) => (
        <a class={`stage-side s${i}`} href={`/games/${g.slug}`} tabindex="-1" data-slug={g.slug} style={`--ac:${g.accent}`}>
          <img src={g.art} alt="" width="480" height="300" decoding="async" />
        </a>
      ))}
      <a class="stage-main" href={`/games/${hero.slug}`} tabindex="-1" data-slug={hero.slug} style={`--ac:${hero.accent}`}>
        <img src={hero.art} alt="" width="480" height="300" decoding="async" fetchpriority="high" />
        <span class="stage-tag"><Fragment set:html={ui('crown')} />{hero.name}</span>
      </a>
      <div class="dice3 hero-dice" id="heroDice" title="ارمي النرد"><Fragment set:html={diceHTML()} /></div>
    </div>
  </section>

  <div id="myCard"></div>

  <!-- continue where you left off (only when this browser still has a seat somewhere) -->
  <section class="sec resume-sec" id="resumeBox" hidden aria-labelledby="resumeTitle">
    <div class="sec-head"><h2 id="resumeTitle"><Fragment set:html={ui('refresh')} />كمّل من وين وقفت</h2></div>
    <div class="resume-list" id="resumeList"></div>
  </section>

  <!-- featured games -->
  <section class="sec" aria-labelledby="featTitle">
    <div class="sec-head">
      <div><h2 id="featTitle"><Fragment set:html={ui('star')} />ألعاب مميّزة</h2><p>اختار وحدة وبلّش خلال ثواني.</p></div>
      <a class="sec-link" href="/games">كل الألعاب<Fragment set:html={icon('chevron')} /></a>
    </div>
    <nav class="cat-row" aria-label="أنواع الألعاب">
      {CATS.map((c) => (
        <a class="cat" href={`/games?f=${c.key}`} data-cat={c.key} hidden={c.hidden}><Fragment set:html={c.ico} />{c.label}</a>
      ))}
    </nav>
    <div class="game-cards feat-row" id="featGrid">{[0, 1, 2, 3].map(() => <div class="gcard skel" aria-hidden="true"></div>)}</div>
  </section>

  <!-- live rooms + leaders -->
  <section class="sec home-split">
    <div class="panel rooms-panel" aria-labelledby="roomsTitle">
      <div class="panel-head">
        <h2 id="roomsTitle"><Fragment set:html={ui('users')} />غرف مفتوحة الآن</h2>
        <span class="live-dot" title="بتتحدّث لحالها"></span>
      </div>
      <div id="roomList" class="room-list"><div class="state state-loading"><span class="spinner"></span><span>عم دوّر…</span></div></div>
    </div>

    <div class="panel leaders-panel" aria-labelledby="leadTitle">
      <div class="panel-head">
        <h2 id="leadTitle"><Fragment set:html={ui('trophy')} />المتصدرين</h2>
        <a class="sec-link" href="/leaders">الكل<Fragment set:html={icon('chevron')} /></a>
      </div>
      <ol class="mini-leaders" id="miniLeaders"><li class="state state-loading"><span class="spinner"></span><span>عم حمّل…</span></li></ol>
    </div>
  </section>

  <!-- how to play -->
  <section class="sec how" aria-labelledby="howTitle">
    <div class="sec-head"><div><h2 id="howTitle"><Fragment set:html={ui('sparkle')} />كيف بتلعب؟</h2><p>تلات خطوات وبتكونوا عم تلعبوا.</p></div></div>
    <ol class="steps">
      {STEPS.map((s, i) => (
        <li class="step"><span class="step-n">{i + 1}</span><span class="step-ico"><Fragment set:html={s.ico} /></span><b>{s.title}</b><p>{s.text}</p></li>
      ))}
    </ol>
    <div class="how-cta"><a class="btn btn-gold big" href="/games"><Fragment set:html={icon('library')} />تصفّح مكتبة الألعاب</a></div>
  </section>

  <div class="ad-wrap" data-ad="home_bottom" hidden></div>
</Base>

<style is:global>
  /* ---------------------------------------------------------------- hero */
  .hero { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; padding: 30px 0 4px; }
  .hero h1 { font-size: clamp(34px, 5.2vw, 60px); font-weight: 900; margin: 16px 0 14px; letter-spacing: -.5px; line-height: 1.15; }
  .hero .grad { background: linear-gradient(90deg, var(--gold), #ffe08a 45%, var(--cyan2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .lead { color: #c3d3e6; font-size: 18px; line-height: 1.85; margin: 0 0 24px; max-width: 520px; }
  .hero-cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .hero-cta .btn { min-height: 52px; }
  .trust { list-style: none; padding: 0; margin: 22px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .trust li { display: inline-flex; align-items: center; gap: 7px; padding: 6px 13px 6px 11px; border-radius: 99px; font-weight: 800; font-size: 14px;
    color: #d6e4f3; background: rgba(14, 28, 61, .55); border: 1px solid rgba(47, 226, 255, .18); }
  .trust .ui-ico { color: var(--cyan2); }
  .hero-live { display: flex; align-items: center; gap: 9px; margin: 14px 0 0; color: var(--muted); font-weight: 700; font-size: 14px; }
  .hero-live b { color: var(--text); }

  /* stage: the real game art, ثروة in front, with a pair of 3D dice */
  .stage { position: relative; width: min(100%, 500px); aspect-ratio: 1.18; margin-inline: auto; }
  .stage-glow { position: absolute; inset: 6% 4%; border-radius: 50%; pointer-events: none;
    background: radial-gradient(closest-side, rgba(0, 180, 255, .34), rgba(0, 120, 255, .12) 55%, transparent); filter: blur(14px); }
  .stage-main, .stage-side { position: absolute; display: block; border-radius: 20px; overflow: hidden; aspect-ratio: 8 / 5;
    border: 1px solid color-mix(in srgb, var(--ac) 45%, transparent); background: #071436; }
  .stage-main img, .stage-side img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .stage-main { width: 76%; left: 12%; top: 22%; z-index: 3;
    box-shadow: 0 30px 60px rgba(0, 0, 0, .55), 0 0 0 1px rgba(255, 255, 255, .04), 0 0 46px color-mix(in srgb, var(--ac) 22%, transparent);
    animation: floaty 7s ease-in-out infinite; }
  .stage-side { width: 50%; z-index: 1; opacity: .9; box-shadow: 0 18px 40px rgba(0, 0, 0, .5); }
  .stage-side.s0 { left: -2%; top: 4%; transform: rotate(-8deg); }
  .stage-side.s1 { right: -2%; top: 2%; transform: rotate(7deg); }
  .stage-tag { position: absolute; top: 12px; inset-inline-start: 12px; display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px 4px 10px; border-radius: 99px;
    font-size: 15px; font-weight: 900; color: #fff; background: rgba(3, 8, 22, .72); border: 1px solid rgba(255, 197, 61, .45); backdrop-filter: blur(4px); }
  .stage-tag .ui-ico { color: var(--gold); width: 17px; height: 17px; }
  .hero-dice { position: absolute; z-index: 4; inset-inline-end: 5%; bottom: 10%; --d: 54px; gap: 14px; padding: 8px; border: 0; background: none; cursor: pointer;
    filter: drop-shadow(0 14px 18px rgba(0, 0, 0, .5)) drop-shadow(0 0 16px rgba(0, 180, 255, .25)); }
  .hero-dice .die3d:nth-child(1) { margin-top: 16px; }
  @keyframes floaty { 50% { translate: 0 -8px; } }

  /* my card */
  .my-card { margin-top: 30px; display: flex; align-items: center; gap: 14px; flex-wrap: wrap; text-decoration: none !important; color: var(--text);
    background: linear-gradient(90deg, rgba(0, 180, 255, .12), rgba(255, 197, 61, .06)); border: 1px solid rgba(47, 226, 255, .3); border-radius: 20px; padding: 14px 18px; }
  .my-card:hover { border-color: rgba(47, 226, 255, .6); }
  .my-card .who { flex: 1; min-width: 160px; }
  .my-card .who small { display: block; color: var(--muted); }
  .my-stats { display: flex; gap: 8px; flex-wrap: wrap; }
  .my-stats span { display: inline-flex; align-items: center; gap: 6px; background: rgba(3, 8, 22, .55); border: 1px solid var(--line2); border-radius: 12px; padding: 6px 12px; color: var(--muted); font-size: 13.5px; }
  .my-stats b { color: var(--gold); font-size: 16px; }
  .my-stats .ui-ico { color: var(--cyan2); }

  /* continue where you left off */
  .resume-sec { margin-top: 34px; }
  .resume-sec .sec-head { margin-bottom: 12px; }
  .resume-sec h2 .ui-ico { color: var(--gold); }
  .resume-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 10px; }
  .resume-list .room-item { animation: none; }
  .resume-list .btn { min-height: 44px; }

  /* categories */
  .cat-row { display: flex; gap: 8px; flex-wrap: wrap; margin: -4px 0 16px; }
  .cat { display: inline-flex; align-items: center; gap: 7px; min-height: 44px; padding: 7px 15px; border-radius: 99px; font-weight: 800; font-size: 14px;
    color: #c9d8ea; background: rgba(14, 28, 61, .55); border: 1px solid var(--line2); text-decoration: none !important; transition: border-color .15s, color .15s, background .15s; }
  .cat:hover { color: var(--text); border-color: rgba(0, 180, 255, .55); background: rgba(0, 180, 255, .1); }
  .cat .ui-ico { width: 18px; height: 18px; color: var(--cyan2); }
  .cat[data-cat="cards"] .ui-ico { color: var(--gold); }

  /* featured row */
  .feat-row { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .feat-row .gcard-top h3 { font-size: 20px; }
  .feat-row .gc-go { display: none; }

  /* rooms + leaders */
  .home-split { display: grid; grid-template-columns: 1.5fr 1fr; gap: 18px; align-items: start; }
  .mini-leaders { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
  .ml-row { display: grid; grid-template-columns: 26px auto minmax(0, 1fr) auto; align-items: center; gap: 10px; min-height: 48px; padding: 6px 10px; border-radius: 12px; color: var(--text); text-decoration: none !important; }
  .ml-row:hover { background: rgba(0, 180, 255, .08); }
  .ml-rank { font-weight: 900; color: var(--muted); text-align: center; }
  .mini-leaders li:nth-child(1) .ml-rank { color: var(--gold); }
  .mini-leaders li:nth-child(2) .ml-rank { color: #cbd5e1; }
  .mini-leaders li:nth-child(3) .ml-rank { color: #fb923c; }
  .ml-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 800; }
  .ml-pts { display: inline-flex; align-items: center; gap: 4px; color: var(--gold); font-weight: 900; direction: ltr; }
  .ml-pts .ui-ico { width: 15px; height: 15px; }
  .rooms-panel .room-item .btn { min-height: 44px; min-width: 64px; }

  /* how to play */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; counter-reset: none; }
  .step { position: relative; padding: 22px 20px 20px; border-radius: 20px; border: 1px solid var(--line);
    background: radial-gradient(240px 120px at 85% 0%, rgba(0, 180, 255, .12), transparent 70%), linear-gradient(180deg, rgba(14, 28, 61, .55), rgba(10, 21, 48, .85)); }
  .step b { display: block; font-size: 19px; font-weight: 900; margin: 12px 0 4px; }
  .step p { margin: 0; color: var(--muted); line-height: 1.75; font-size: 14.5px; }
  .step-ico { display: inline-flex; align-items: center; justify-content: center; width: 52px; height: 52px; border-radius: 16px;
    background: linear-gradient(135deg, rgba(0, 180, 255, .2), rgba(47, 226, 255, .06)); border: 1px solid rgba(47, 226, 255, .3); color: var(--cyan2); }
  .step-ico .ui-ico { width: 26px; height: 26px; }
  .step-n { position: absolute; top: 14px; inset-inline-end: 18px; font-size: 44px; font-weight: 900; line-height: 1; color: rgba(47, 226, 255, .12); }
  .how-cta { display: flex; justify-content: center; margin-top: 24px; }

  @media (max-width: 1020px) {
    .feat-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; text-align: center; gap: 4px; padding-top: 8px; }
    .lead { margin-inline: auto; }
    .hero-cta, .trust, .hero-live { justify-content: center; }
    .stage { order: -1; width: min(100%, 420px); }
    .home-split { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .hero h1 { margin: 12px 0 10px; }
    .lead { font-size: 16px; margin-bottom: 18px; }
    .hero-cta .btn { flex: 1 1 100%; }
    .trust { gap: 6px; margin-top: 16px; }
    .trust li { font-size: 13px; padding: 5px 11px 5px 9px; }
    .stage { width: min(100%, 360px); aspect-ratio: 1.36; }
    .stage-main { width: 80%; left: 10%; top: 18%; }
    .stage-tag { top: 8px; inset-inline-start: 8px; font-size: 13.5px; }
    .hero-dice { --d: 40px; gap: 10px; inset-inline-end: 3%; bottom: 0; }
    .cat-row { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-inline: -16px; padding-inline: 16px; }
    .cat-row::-webkit-scrollbar { display: none; }
    .cat { flex: 0 0 auto; }
    /* phones: featured games scroll sideways */
    .feat-row { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 12px; margin-inline: -16px; padding: 4px 16px 10px; scrollbar-width: none; }
    .feat-row::-webkit-scrollbar { display: none; }
    .feat-row .gcard { flex: 0 0 78%; scroll-snap-align: center; }
    .feat-row .gcard:hover { transform: none; }
    .resume-list { grid-template-columns: 1fr; }
    .steps { grid-template-columns: 1fr; gap: 10px; }
    .step { display: grid; grid-template-columns: auto 1fr; column-gap: 14px; align-items: center; padding: 14px 16px; }
    .step-ico { grid-row: 1 / span 2; width: 46px; height: 46px; }
    .step b { margin: 0; font-size: 17px; }
    .step p { font-size: 13.5px; }
    .step-n { font-size: 30px; top: 10px; inset-inline-end: 14px; }
    .how-cta .btn { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .stage-main { animation: none; }
  }
</style>

<script>
  import '../../../public/fx.js';
  import { $, $$, esc, fmtN, ui, api, toast, avatarHTML, loadSession, session, mountAds, modal } from '../lib/client';
  import { liveGames, type LiveGame } from '../components/games/catalog';
  import { gameCardHTML } from '../components/games/cards';
  import { openRooms, roomItemHTML, myRooms, findRoom, roomUrl, askName, join, playError, rememberName, savedName, isTharwa, type OpenRoom } from '../components/games/play';

  let games: LiveGame[] = [];
  const bySlug = (s: string) => games.find((g) => g.slug === s);
  const isCards = (g: LiveGame) => (g.tags || []).some((t) => /^(cards|ورق|ورق الشدة|شدة)$/i.test(String(t).trim()));

  // ---- hero dice: tap to roll. Every face shows the rolled value, so no wrong number ever flashes.
  const dice = $('#heroDice')!;
  window.FX.setDice(dice, [5, 6], false);
  dice.addEventListener('click', () => {
    const v = [1 + Math.floor(Math.random() * 6), 1 + Math.floor(Math.random() * 6)];
    window.FX.setDice(dice, v, true);
    window.FX.Sound.play('dice');
  });

  // ---- hero art: hide games that aren't in the live registry
  function drawStage() {
    $$<HTMLElement>('.stage [data-slug]').forEach((a) => { a.style.visibility = bySlug(a.dataset.slug || '') ? '' : 'hidden'; });
  }

  function drawGames() {
    const grid = $('#featGrid')!;
    if (!session.ok) { grid.innerHTML = `<div class="panel state state-error" style="grid-column:1/-1">${ui('warn')}<span>ما قدرنا نوصل للسيرفر — جرّب تحدّث الصفحة.</span></div>`; return; }
    if (!games.length) { grid.innerHTML = `<div class="panel state state-empty" style="grid-column:1/-1">${ui('sparkle')}<span>ما في ألعاب مفعّلة هلق.</span></div>`; return; }
    // four games, and when card games exist one of them is a card game (so every kind shows up)
    const firstCard = games.find(isCards);
    const feat = firstCard ? [...games.filter((g) => !isCards(g)).slice(0, 3), firstCard] : games.slice(0, 4);
    grid.innerHTML = feat.map((g, i) => gameCardHTML(g, i)).join('');
    // categories: «ورق الشدة» shows up as soon as a card game is in the registry
    const cards = $('.cat[data-cat="cards"]');
    if (cards) cards.hidden = !games.some(isCards);
    const live = games.reduce((n, g) => n + (g.live || 0), 0);
    const hl = $('#heroLive')!;
    hl.hidden = !live && games.length < 2;
    $('span:last-child', hl)!.innerHTML = live
      ? `<b>${fmtN(live)}</b> لاعب عم يلعبوا هلق · <b>${games.length}</b> ألعاب بالمكتبة`
      : `<b>${games.length}</b> ألعاب بالمكتبة، وكلها جاهزة تلعبها هلق`;
    ($('.live-dot', hl) as HTMLElement).hidden = !live;
    if (session.ok && games.length) drawStage();
  }

  function drawMe() {
    const me = session.me, box = $('#myCard')!;
    box.innerHTML = me ? `<a class="my-card" href="/u/${encodeURIComponent(me.username)}">${avatarHTML(me.avatar, 52, me.color)}
      <div class="who"><b>أهلين ${esc(me.displayName)}</b><small dir="ltr">@${esc(me.username)}</small></div>
      <div class="my-stats"><span>${ui('star')}<b>${fmtN(me.points)}</b> نقطة</span><span>${ui('trophy')}<b>${fmtN(me.wins)}</b> فوز</span><span>${ui('dice')}<b>${fmtN(me.games)}</b> لعبة</span></div></a>` : '';
  }

  // ---- open rooms across every game (refreshed every 5 s while the tab is visible)
  let failed = 0, lastRefresh = 0;
  async function refreshRooms() {
    if (document.hidden || !games.length) return;
    if (Date.now() - lastRefresh < 2000) return; // visibilitychange + timer can fire together
    lastRefresh = Date.now();
    const box = $('#roomList')!;
    const results = await Promise.all(games.map((g) => openRooms(g.slug).then((r) => r || [], () => null)));
    const ok = results.filter((r): r is OpenRoom[] => r !== null);
    if (!ok.length) {
      if (++failed >= 2) box.innerHTML = `<div class="state state-error">${ui('warn')}<span>ما قدرنا نجيب الغرف — عم نجرّب كمان…</span></div>`;
      return;
    }
    failed = 0;
    const all = ok.flat().sort((a, b) => b.count - a.count).slice(0, 8);
    box.innerHTML = all.length
      ? all.map((r) => { const g = bySlug(r.slug); return roomItemHTML(r, g?.name, g?.art); }).join('')
      : `<div class="room-empty">${ui('dice')}ما في غرف مفتوحة هلق — <a href="/games">اختار لعبة</a> وابدأ وحدة.</div>`;
  }

  async function drawResume() {
    const list = await myRooms(games.map((g) => g.slug)).catch(() => []);
    const box = $('#resumeBox')!;
    box.hidden = !list.length;
    $('#resumeList')!.innerHTML = list.map((r) => {
      const g = bySlug(r.slug);
      const st = r.status === 'lobby' ? 'بالانتظار' : 'اللعبة شغّالة';
      return `<div class="room-item resume">${g?.art ? `<img class="ri-art" src="${esc(g.art)}" alt="" width="48" height="30">` : ''}
        <div class="ri-text"><b>${esc(g?.name || r.slug)}</b><small><span class="ltr">${esc(r.code)}</span><i class="dot-sep"></i>${st}</small></div>
        <a class="btn btn-cyan sm" href="${esc(roomUrl(r.slug, r.code))}">${ui('play')}كمّل</a></div>`;
    }).join('');
  }

  // ---- entering a room from a list
  async function enter(slug: string, code: string, btn: HTMLButtonElement) {
    if (isTharwa(slug)) { const n = savedName(); if (n) rememberName(n); location.href = roomUrl(slug, code); return; }
    const name = await askName();
    if (!name) return;
    btn.disabled = true; btn.classList.add('loading');
    try { location.href = await join(slug, code, name); }
    catch (e) { toast(playError(e, slug, true)); btn.disabled = false; btn.classList.remove('loading'); }
  }
  $('#roomList')!.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('[data-room]');
    if (b) enter(b.dataset.slug || 'tharwa', b.dataset.room || '', b);
  });

  // ---- «عندي كود غرفة»: works for any game (ثروة codes are checked first, then the other games' open rooms)
  $('#codeBtn')!.addEventListener('click', () => {
    const m = modal('ادخل بكود الغرفة', `<form id="codeForm" class="name-form">
      <p class="modal-text" style="margin:0">صاحبك بعتلك كود؟ اكتبه هون وبندخّلك عالغرفة.</p>
      <input class="input ltr" id="codeIn" maxlength="8" placeholder="abc12" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="go" style="text-align:center;font-weight:800;letter-spacing:3px;font-size:18px">
      <button class="btn btn-gold block" type="submit" id="codeGo">${ui('key')}ادخل</button></form>`);
    const input = $('#codeIn', m.root) as HTMLInputElement, go = $('#codeGo', m.root) as HTMLButtonElement;
    input.focus();
    input.addEventListener('input', () => { input.value = input.value.replace(/[^A-Za-z0-9]/g, ''); });
    $('#codeForm', m.root)!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const code = input.value.trim();
      if (code.length < 4) { toast('اكتب كود الغرفة'); input.focus(); return; }
      go.disabled = true; go.classList.add('loading');
      try {
        const hit = await findRoom(code, games.map((g) => g.slug));
        if (hit && isTharwa(hit.slug)) { location.href = roomUrl('tharwa', hit.code); return; }
        if (hit) {
          m.close();
          // a game that already started can only be watched: the room page handles spectators
          if (hit.status !== 'lobby') { location.href = roomUrl(hit.slug, hit.code); return; }
          const name = await askName();
          if (!name) return;
          location.href = await join(hit.slug, hit.code, name);
          return;
        }
        toast('ما لقينا غرفة مفتوحة بهالكود — تأكّد منه');
      } catch (err) { toast(playError(err, 'g', true)); }
      go.disabled = false; go.classList.remove('loading');
    });
  });

  // ---- leaders (top 5)
  async function drawLeaders() {
    const box = $('#miniLeaders')!;
    try {
      const list = await api<{ username: string; displayName: string; avatar: string; color: string | null; points: number }[]>('/api/leaders');
      box.innerHTML = list.length
        ? list.slice(0, 5).map((u, i) => `<li><a class="ml-row" href="/u/${encodeURIComponent(u.username)}"><span class="ml-rank">${i + 1}</span>${avatarHTML(u.avatar, 34, u.color)}
            <span class="ml-name">${esc(u.displayName)}</span><span class="ml-pts">${ui('star')}${fmtN(u.points)}</span></a></li>`).join('')
        : `<li class="room-empty">${ui('trophy')}لسا ما حدا عالقائمة — كون أول واحد!</li>`;
    } catch {
      box.innerHTML = `<li class="state state-error">${ui('warn')}<span>ما قدرنا نجيب القائمة</span></li>`;
    }
  }

  loadSession().then(() => {
    games = liveGames(session.site.games);
    drawGames(); drawMe(); mountAds();
    refreshRooms(); drawResume();
    setInterval(refreshRooms, 5000);
    document.addEventListener('visibilitychange', refreshRooms);
  });
  drawLeaders();
</script>
