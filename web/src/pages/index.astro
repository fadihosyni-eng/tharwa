</style>

<script>
  import { $, $$, esc, fmtN, ui, api, toast, avatarHTML, loadSession, session, mountAds, modal } from '../lib/client';
  import { mountChrome } from '../lib/chrome';
  import { liveGames, norm, type LiveGame } from '../components/games/catalog';
  import { start, askName, playError, openRooms, roomItemHTML, myRooms, findRoom, roomUrl, join, rememberName, savedName, isTharwa, type OpenRoom, type Mode } from '../components/games/play';

  mountChrome();

  const H = document.documentElement;
  const STOP_OF: Record<string, number> = { tharwa: 1, tarneeb: 2, '400': 2, trix: 2, konkan: 2, ludo: 3, xo: 4, connect4: 4 };
  const CAT_OF = (g: LiveGame) => (STOP_OF[g.slug] === 2 || g.tags.includes('cards') ? 'cards' : STOP_OF[g.slug] === 4 ? 'quick' : 'board');
  const CAT_LABEL: Record<string, string> = { cards: 'ورق الشدة', board: 'ألعاب لوح', quick: 'ألعاب سريعة' };
  const ico = (n: string, cls = 'h-i') => `<svg class="${cls}" aria-hidden="true"><use href="#i-${n}"/></svg>`;
  const pl = (g: LiveGame) => `<bdi dir="ltr">${g.minPlayers === g.maxPlayers ? g.minPlayers : `${g.minPlayers}–${g.maxPlayers}`}</bdi> لاعبين`;
  const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  const onIdle = (cb: () => void, timeout = 2000) => ('requestIdleCallback' in window ? (window as any).requestIdleCallback(cb, { timeout }) : setTimeout(cb, 200));

  let games: LiveGame[] = [];
  const bySlug = (s: string) => games.find((g) => g.slug === s);
  const rooms: Record<string, number> = {};

  // ---------------------------------------------------------------- panels (one per landmark)
  type Panel = { el: HTMLElement; sec: HTMLElement; stop: number; ids: string[]; cur: string; shown: boolean };
  const panels: Panel[] = [];
  $$<HTMLElement>('.h-panel').forEach((el) => {
    const stop = +(el.dataset.stop || 0);
    const ids = $$<HTMLElement>('.h-tab', el).map((t) => t.dataset.g || '');
    const first = $<HTMLElement>('[data-act]', el)?.dataset.slug || '';
    panels[stop] = { el, sec: el.closest('.h-stop') as HTMLElement, stop, ids: ids.length ? ids : [first], cur: first, shown: false };
    const tabs = $('.h-tabs', el);
    tabs?.addEventListener('click', (e) => { const t = (e.target as Element).closest<HTMLElement>('.h-tab'); if (t) select(panels[stop], t.dataset.g || ''); });
    tabs?.addEventListener('keydown', (e) => {
      const list = $$<HTMLElement>('.h-tab:not([hidden])', el), i = list.indexOf(document.activeElement as HTMLElement);
      const d = e.key === 'ArrowLeft' ? 1 : e.key === 'ArrowRight' ? -1 : 0;
      if (i < 0 || !d) return;
      e.preventDefault(); const n = list[(i + d + list.length) % list.length]; n.focus(); select(panels[stop], n.dataset.g || '');
    });
  });

  let onGameCb: ((stop: number, tint: string) => void) | null = null;
  function liveLine(g: LiveGame | undefined) {
    if (!g) return '';
    const parts: string[] = [];
    if (rooms[g.slug] > 0) parts.push(`<bdi dir="ltr">${fmtN(rooms[g.slug])}</bdi> ${rooms[g.slug] === 1 || rooms[g.slug] >= 11 ? 'غرفة مفتوحة' : 'غرف مفتوحة'}`);
    if (g.live > 0) parts.push(`<bdi dir="ltr">${fmtN(g.live)}</bdi> عم يلعبوا هلق`);
    return parts.join(' · ');
  }
  function fill(P: Panel, slug: string) {
    const g = bySlug(slug), el = P.el;
    P.cur = slug;
    $$<HTMLElement>('.h-tab', el).forEach((t) => { const on = t.dataset.g === slug; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; });
    const off = $('.h-p-off', el)!, ctas = $('.h-p-ctas', el)!, more = $<HTMLAnchorElement>('.h-p-more', el)!;
    if (!g) {
      // the registry has none of this landmark's games switched on: say so, never offer a fake button
      off.hidden = false; ctas.hidden = true; more.hidden = true; $('.h-liveline', el)!.hidden = true;
      return;
    }
    off.hidden = true; ctas.hidden = false; more.hidden = false;
    $('.h-p-name', el)!.textContent = g.name;
    $('.h-p-pitch', el)!.textContent = g.description;
    $('.h-meta', el)!.innerHTML = `<li>${ico('users')}<span>${pl(g)}</span></li>` +
      (g.duration ? `<li>${ico('clock')}<span><bdi dir="ltr">${esc(g.duration.replace(/\s*د$/, ''))}</bdi> دقيقة</span></li>` : '') +
      `<li>${ico(el.dataset.ico || 'board')}${esc(el.dataset.type || '')}</li>`;
    $$<HTMLElement>('[data-act]', el).forEach((b) => { b.dataset.slug = g.slug; });
    more.href = g.url;
    const line = liveLine(g), live = $('.h-liveline', el)!;
    live.hidden = !line; $('span', live)!.innerHTML = line;
    onGameCb?.(P.stop, g.accent);
  }
  // tab switch: a short CSS fade (class «swap»), then the new game's text
  function select(P: Panel, slug: string) {
    if (!P || P.cur === slug) return;
    if (!P.shown || reduce()) { fill(P, slug); return; }
    P.el.classList.add('swap');
    setTimeout(() => { fill(P, slug); P.el.classList.remove('swap'); }, 200);
  }

  // ---------------------------------------------------------------- the city: lazy stills + crossfade
  const scenes = $$<HTMLElement>('.h-scene');
  function loadScene(n: number) {
    const sc = scenes[n], pic = sc && $('picture[data-lazy]', sc);
    if (!pic) return;
    pic.removeAttribute('data-lazy');
    $$<HTMLSourceElement>('source', pic).forEach((s) => { s.srcset = s.dataset.srcset || ''; });
    const img = $<HTMLImageElement>('img', pic)!;
    img.srcset = img.dataset.srcset || '';
    const done = () => { sc.classList.add('ready'); if (want === n) showScene(n); };
    if (img.complete && img.naturalWidth) done(); else img.addEventListener('load', done, { once: true });
  }
  let want = 0;
  function showScene(n: number) {
    want = n;
    if (!scenes[n]?.classList.contains('ready')) { loadScene(n); return; } // keep the current still until the next one is decoded
    scenes.forEach((s, i) => s.classList.toggle('is-on', i === n));
  }

  // ---------------------------------------------------------------- the tour: which section is in the middle of the screen
  const rail = $('#hxRail')!, railBtns = $$<HTMLElement>('button', rail), navA = $$<HTMLElement>('.h-nav a[data-cat]'), scrim = $('#hxScrim')!;
  const sections = [$('#hero')!, ...panels.filter(Boolean).map((P) => P.sec), $('#how')!];
  let active = -1;
  function setActive(act: number) {
    if (act === active) return;
    active = act;
    panels.forEach((P, i) => { if (!P) return; P.shown = i === act; P.sec.classList.toggle('is-on', i === act); });
    showScene(act >= 1 && act <= 4 ? act : 0);
    if (act >= 1 && act <= 3) loadScene(act + 1);
    railBtns.forEach((b, i) => b.classList.toggle('on', i + 1 === act));
    rail.classList.toggle('on', act >= 1 && act <= 4);
    const cat = act === 2 ? 0 : act === 1 || act === 3 ? 1 : act === 4 ? 2 : -1;
    navA.forEach((a) => a.classList.toggle('on', +(a.dataset.cat || -1) === cat));
    scrim.classList.toggle('on', act <= 4);
  }
  const inBand = new Set<number>();
  const bandIO = new IntersectionObserver((ents) => {
    for (const e of ents) { const i = sections.indexOf(e.target as HTMLElement); if (e.isIntersecting) inBand.add(i); else inBand.delete(i); }
    if (inBand.size) setActive(Math.max(...inBand));
  }, { rootMargin: '-48% 0px -48% 0px' });
  sections.forEach((s) => bandIO.observe(s));
  setActive(0);
  // the first landmark still is fetched only once the visitor starts moving (not on first load)
  const warm = () => { loadScene(1); ['scroll', 'wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((t) => removeEventListener(t, warm)); };
  ['scroll', 'wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((t) => addEventListener(t, warm, { passive: true }));

  // ---------------------------------------------------------------- real play actions
  async function act(btn: HTMLButtonElement) {
    const slug = btn.dataset.slug || '', mode = (btn.dataset.act || 'quick') as Mode;
    if (!bySlug(slug)) { toast('هاللعبة مو متاحة هلق'); return; }
    const name = await askName();
    if (!name) return;
    btn.disabled = true; btn.classList.add('loading');
    try { location.href = await start(slug, mode, name); }
    catch (e) { toast(playError(e, slug)); btn.disabled = false; btn.classList.remove('loading'); }
  }

  // ---------------------------------------------------------------- navigation
  let geo = { vh: innerHeight, tops: [0] as number[], holds: [0] as number[], how: 0 };
  function measure() {
    const vh = innerHeight, sy = scrollY, stops = $$<HTMLElement>('.h-stop');
    const tops = [0, ...stops.map((s) => s.getBoundingClientRect().top + sy)];
    const holds = tops.map((t, i) => (i === 0 ? 0 : t + stops[i - 1].offsetHeight - vh));
    geo = { vh, tops, holds, how: $('#how')!.getBoundingClientRect().top + sy };
    return geo;
  }
  function flyTo(i: number) {
    measure();
    if (i >= 1 && i <= 4) loadScene(i);
    const y = i <= 0 ? 0 : i <= 4 ? geo.tops[i] + geo.vh * 0.04 : geo.how;
    scrollTo({ top: y, behavior: reduce() ? 'auto' : 'smooth' });
  }
  document.addEventListener('click', (e) => {
    const t = e.target as Element;
    const a = t.closest<HTMLElement>('[data-fly]');
    if (a) { e.preventDefault(); (t.closest('details') as HTMLDetailsElement | null)?.removeAttribute('open'); flyTo(+(a.dataset.fly || 0)); return; }
    const b = t.closest<HTMLButtonElement>('[data-act]');
    if (b) { act(b); return; }
    if (t.closest('[data-code], #codeBtn')) codeModal();
  });

  // ---------------------------------------------------------------- command palette (results open the real game page)
  const pal = $('#hxPal')!, palq = $<HTMLInputElement>('#hxPalQ')!, pallist = $('#hxPalList')!;
  let palSel = 0, palItems: LiveGame[] = [], lastFocus: Element | null = null;
  function palRender() {
    const q = norm(palq.value);
    palItems = games.filter((g) => !q || norm([g.name, ...g.aliases, CAT_LABEL[CAT_OF(g)]].join(' ')).includes(q));
    if (!games.length) { pallist.innerHTML = `<li class="h-pal-empty" role="presentation">${session.ok ? 'ما في ألعاب مفعّلة هلق.' : 'ما قدرنا نوصل للسيرفر، جرّب تحدّث الصفحة.'}</li>`; return; }
    if (!palItems.length) { pallist.innerHTML = `<li class="h-pal-empty" role="presentation">ما لقينا لعبة بهالاسم. جرّب «طرنيب» أو «لودو».</li>`; return; }
    palSel = Math.min(palSel, palItems.length - 1);
    let html = '', lastCat = '';
    const ordered = q ? palItems : (['cards', 'board', 'quick'] as const).flatMap((c) => palItems.filter((g) => CAT_OF(g) === c));
    palItems = ordered;
    ordered.forEach((g, i) => {
      if (!q && CAT_OF(g) !== lastCat) { lastCat = CAT_OF(g); html += `<li class="h-grp" role="presentation">${CAT_LABEL[lastCat]}</li>`; }
      html += `<li role="option" id="po-${esc(g.slug)}" data-i="${i}" aria-selected="${i === palSel}"><a href="${esc(g.url)}" tabindex="-1">${g.art ? `<img src="${esc(g.art)}" alt="" loading="lazy">` : ''}<span class="h-t"><b>${esc(g.name)}</b><small>${CAT_LABEL[CAT_OF(g)]} · ${pl(g)}</small></span><span class="h-go">افتح اللعبة</span></a></li>`;
    });
    pallist.innerHTML = html;
    palq.setAttribute('aria-activedescendant', 'po-' + palItems[palSel].slug);
  }
  function palOpen() {
    lastFocus = document.activeElement; pal.classList.add('open'); palq.value = ''; palSel = 0; palRender();
    requestAnimationFrame(() => palq.focus());
  }
  function palClose() { pal.classList.remove('open'); (lastFocus as HTMLElement | null)?.focus?.(); }
  $('#hxOpenPal')!.addEventListener('click', palOpen);
  palq.addEventListener('input', () => { palSel = 0; palRender(); });
  pallist.addEventListener('mousemove', (e) => { const li = (e.target as Element).closest<HTMLElement>('[data-i]'); if (li && +(li.dataset.i || 0) !== palSel) { palSel = +(li.dataset.i || 0); palRender(); } });
  pal.addEventListener('click', (e) => { if (e.target === pal) palClose(); });
  document.addEventListener('keydown', (e) => {
    const typing = /INPUT|TEXTAREA|SELECT/.test((document.activeElement as HTMLElement)?.tagName || '');
    if (((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') || (e.key === '/' && !typing)) {
      e.preventDefault(); pal.classList.contains('open') ? palClose() : palOpen(); return;
    }
    if (!pal.classList.contains('open')) return;
    if (e.key === 'Escape') { e.preventDefault(); palClose(); }
    else if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault(); if (!palItems.length) return;
      palSel = (palSel + (e.key === 'ArrowDown' ? 1 : -1) + palItems.length) % palItems.length; palRender();
      document.getElementById('po-' + palItems[palSel].slug)?.scrollIntoView({ block: 'nearest' });
    } else if (e.key === 'Enter') { e.preventDefault(); const g = palItems[palSel]; if (g) location.href = g.url; }
    else if (e.key === 'Tab') { e.preventDefault(); palq.focus(); }
  });

  // ---------------------------------------------------------------- live registry → panels, tabs, index
  function applyGames() {
    for (const P of panels) {
      if (!P) continue;
      const live = P.ids.filter((id) => bySlug(id));
      $$<HTMLElement>('.h-tab', P.el).forEach((t) => { t.hidden = !bySlug(t.dataset.g || ''); });
      const tabs = $('.h-tabs', P.el); if (tabs) tabs.hidden = live.length < 2;
      P.cur = '';
      fill(P, live[0] || P.ids[0]);
    }
    // index: only enabled games (plus any new registry game the city has no landmark for yet)
    $$<HTMLElement>('#hxIndexCols li[data-slug]').forEach((li) => { li.hidden = !bySlug(li.dataset.slug || ''); });
    for (const g of games.filter((x) => !(x.slug in STOP_OF))) {
      const ul = $(`#hxIndexCols .h-cat[data-cat="${CAT_OF(g)}"] ul`);
      ul?.insertAdjacentHTML('beforeend', `<li data-slug="${esc(g.slug)}"><a href="${esc(g.url)}">${esc(g.name)}<small>${pl(g)}</small>${ico('arrow', 'h-i h-ar')}</a></li>`);
    }
    $$<HTMLElement>('#hxIndexCols .h-cat').forEach((c) => { c.hidden = !$$('li:not([hidden])', c).length; });
  }

  // ---------------------------------------------------------------- open rooms (real, refreshed while visible)
  let failed = 0, lastRefresh = 0;
  async function refreshRooms() {
    if (document.hidden || !games.length || Date.now() - lastRefresh < 4000) return;
    lastRefresh = Date.now();
    const box = $('#roomList')!;
    const results = await Promise.all(games.map((g) => openRooms(g.slug).then((r) => r || [], () => null)));
    const ok = results.filter((r): r is OpenRoom[] => r !== null);
    games.forEach((g, i) => { rooms[g.slug] = results[i] ? (results[i] as OpenRoom[]).length : 0; });
    for (const P of panels) if (P && bySlug(P.cur)) { const live = $('.h-liveline', P.el)!, line = liveLine(bySlug(P.cur)); live.hidden = !line; $('span', live)!.innerHTML = line; }
    if (!ok.length) { if (++failed >= 2) box.innerHTML = `<div class="state state-error">${ui('warn')}<span>ما قدرنا نجيب الغرف، عم نجرّب كمان…</span></div>`; return; }
    failed = 0;
    const all = ok.flat().sort((a, b) => b.count - a.count).slice(0, 6);
    box.innerHTML = all.length
      ? all.map((r) => { const g = bySlug(r.slug); return roomItemHTML(r, g?.name, g?.art); }).join('')
      : `<div class="room-empty">${ui('dice')}ما في غرف مفتوحة هلق. اختار لعبة واكبس «غرفة مع صحابي».</div>`;
  }
  async function enter(slug: string, code: string, btn: HTMLButtonElement) {
    if (isTharwa(slug)) { const n = savedName(); if (n) rememberName(n); location.href = roomUrl(slug, code); return; }
    const name = await askName();
    if (!name) return;
    btn.disabled = true; btn.classList.add('loading');
    try { location.href = await join(slug, code, name); }
    catch (e) { toast(playError(e, slug, true)); btn.disabled = false; btn.classList.remove('loading'); }
  }
  $('#roomList')!.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('[data-room]');
    if (b) enter(b.dataset.slug || 'tharwa', b.dataset.room || '', b);
  });

  // «كمّل من وين وقفت»: rooms this browser still has a seat in
  async function drawResume() {
    const list = await myRooms(games.map((g) => g.slug)).catch(() => []);
    const box = $('#hxResume')!;
    box.hidden = !list.length;
    box.innerHTML = list.length ? `<b>${ico('refresh')}كمّل من وين وقفت</b>` + list.slice(0, 3).map((r) => {
      const g = bySlug(r.slug);
      return `<a href="${esc(roomUrl(r.slug, r.code))}">${esc(g?.name || r.slug)}<small dir="ltr">${esc(r.code)}</small><span>${r.status === 'lobby' ? 'بالانتظار' : 'شغّالة'}</span></a>`;
    }).join('') : '';
  }

  // «عندي كود غرفة»: same flow as before (ثروة codes first, then the other games)
  function codeModal() {
    const m = modal('ادخل بكود الغرفة', `<form id="codeForm" class="name-form">
      <p class="modal-text" style="margin:0">صاحبك بعتلك كود؟ اكتبه هون وبندخّلك عالغرفة.</p>
      <input class="input ltr" id="codeIn" maxlength="8" placeholder="abc12" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="go" style="text-align:center;font-weight:800;letter-spacing:3px;font-size:18px">
      <button class="btn btn-gold block" type="submit" id="codeGo">${ui('key')}ادخل</button></form>`);
    const input = $('#codeIn', m.root) as HTMLInputElement, go = $('#codeGo', m.root) as HTMLButtonElement;
    input.focus();
    input.addEventListener('input', () => { input.value = input.value.replace(/[^A-Za-z0-9]/g, ''); });
    $('#codeForm', m.root)!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const code = input.value.trim();
      if (code.length < 4) { toast('اكتب كود الغرفة'); input.focus(); return; }
      go.disabled = true; go.classList.add('loading');
      try {
        const hit = await findRoom(code, games.map((g) => g.slug));
        if (hit && isTharwa(hit.slug)) { location.href = roomUrl('tharwa', hit.code); return; }
        if (hit) {
          m.close();
          if (hit.status !== 'lobby') { location.href = roomUrl(hit.slug, hit.code); return; }
          const name = await askName();
          if (!name) return;
          location.href = await join(hit.slug, hit.code, name);
          return;
        }
        toast('ما لقينا غرفة مفتوحة بهالكود، تأكّد منه');
      } catch (err) { toast(playError(err, 'g', true)); }
      go.disabled = false; go.classList.remove('loading');
    });
  }

  async function drawLeaders() {
    const box = $('#miniLeaders')!;
    try {
      const list = await api<{ username: string; displayName: string; avatar: string; color: string | null; points: number }[]>('/api/leaders');
      box.innerHTML = list.length
        ? list.slice(0, 5).map((u, i) => `<li><a class="ml-row" href="/u/${encodeURIComponent(u.username)}"><span class="ml-rank">${i + 1}</span>${avatarHTML(u.avatar, 34, u.color)}
            <span class="ml-name">${esc(u.displayName)}</span><span class="ml-pts">${ui('star')}${fmtN(u.points)}</span></a></li>`).join('')
        : `<li class="room-empty">${ui('trophy')}لسا ما حدا عالقائمة، كون أول واحد.</li>`;
    } catch { box.innerHTML = `<li class="state state-error">${ui('warn')}<span>ما قدرنا نجيب القائمة</span></li>`; }
  }


  // ---------------------------------------------------------------- the fixed header: solid once the hero is gone, height for content
  const hdr = $('#hxHdr')!;
  function syncHeader() { H.style.setProperty('--h-hdr-real', hdr.offsetHeight + 'px'); }
  document.addEventListener('tharwa:banners', syncHeader);
  addEventListener('resize', syncHeader, { passive: true });
  syncHeader();
  const heroEnd = document.createElement('div');
  heroEnd.style.cssText = 'position:absolute;inset:auto 0 0 0;height:1px;pointer-events:none';
  $('#hero')!.appendChild(heroEnd);
  new IntersectionObserver(([e]) => hdr.classList.toggle('solid', !e.isIntersecting && e.boundingClientRect.top < innerHeight),
    { rootMargin: '0px 0px 0px 0px' }).observe(heroEnd);

  // ---------------------------------------------------------------- live data: registry first, the rest when it's needed
  let roomsSeen = false;
  const roomsBox = $('#roomList')!;
  new IntersectionObserver(([e]) => { roomsSeen = e.isIntersecting; if (roomsSeen) refreshRooms(); }, { rootMargin: '300px 0px' }).observe(roomsBox);
  let leadersDone = false;
  new IntersectionObserver(([e]) => { if (e.isIntersecting && !leadersDone) { leadersDone = true; drawLeaders(); } }, { rootMargin: '600px 0px' }).observe($('#miniLeaders')!);

  loadSession().then(() => {
    games = liveGames(session.site.games);
    applyGames(); mountAds();
    onIdle(() => { refreshRooms(); drawResume(); }, 3000);
    // poll open rooms only while their list (or a landmark panel showing counts) is on screen
    setInterval(() => { if (roomsSeen || (active >= 1 && active <= 4)) refreshRooms(); }, 10000);
  });

  // ---------------------------------------------------------------- «جولة 3D»: the live city, opt-in on capable desktops only
  const LS = 'serva_home_3d';
  const btn3d = $<HTMLButtonElement>('#hx3d')!;
  let world: { stop(): void } | null = null, booting = false;
  function capable() {
    if (!matchMedia('(min-width: 1100px) and (pointer: fine) and (hover: hover)').matches || reduce()) return false;
    const nav = navigator as any, c = nav.connection;
    if (c && (c.saveData || /2g|3g/.test(c.effectiveType || '') || c.rtt > 300)) return false;   // Save-Data or a slow link
    if (nav.deviceMemory && nav.deviceMemory < 4) return false;
    if (nav.hardwareConcurrency && nav.hardwareConcurrency < 4) return false;
    try {
      const gl = document.createElement('canvas').getContext('webgl2');
      if (!gl) return false;
      const ext = gl.getExtension('WEBGL_debug_renderer_info');
      const gpu = ext ? String(gl.getParameter(ext.UNMASKED_RENDERER_WEBGL)) : '';
      gl.getExtension('WEBGL_lose_context')?.loseContext();
      if (/Intel|UHD|Iris|Radeon\(TM\) Graphics|Vega \d+ Graphics|Mali|Adreno|PowerVR|SwiftShader|llvmpipe|Software|Basic Render/i.test(gpu)) return false;
    } catch { return false; }
    return true;
  }
  function set3dUI(state: 'off' | 'loading' | 'on') {
    btn3d.setAttribute('aria-pressed', String(state === 'on'));
    btn3d.setAttribute('aria-busy', String(state === 'loading'));
    btn3d.dataset.state = state;
    $('span', btn3d)!.textContent = state === 'on' ? 'إيقاف 3D' : state === 'loading' ? 'عم نجهّز…' : 'جولة 3D';
  }
  async function start3d() {
    if (world || booting) return;
    booting = true; set3dUI('loading');
    try {
      const m = await import('../home/world');
      world = await m.start({ measure, flyTo, onGame: (cb: (stop: number, tint: string) => void) => { onGameCb = cb; } });
      try { localStorage.setItem(LS, '1'); } catch { /* private mode */ }
      set3dUI('on');
    } catch (err) {
      console.warn('3D tour unavailable', err);
      H.classList.remove('h-3d-on'); world = null; set3dUI('off'); toast('الجولة ثلاثية الأبعاد مو متاحة على هالجهاز');
    }
    booting = false;
  }
  function stop3d() {
    world?.stop(); world = null; onGameCb = null;
    try { localStorage.setItem(LS, '0'); } catch { /* private mode */ }
    set3dUI('off');
  }
  btn3d.addEventListener('click', () => (world ? stop3d() : start3d()));
  addEventListener('load', () => onIdle(() => {
    if (!capable()) return;
    btn3d.hidden = false; set3dUI('off');
    let saved = '';
    try { saved = localStorage.getItem(LS) || ''; } catch { /* private mode */ }
    if (saved === '1' || /[?&]3d\b/.test(location.search)) start3d();
  }, 4000), { once: true });
</script>
