---
import Base from '../layouts/Base.astro';
import { ui } from '../lib/art-build';
import { icon } from '../components/icons';
import { CATALOG } from '../components/games/catalog';
---
<Base active="home" description="Serva Games — منصة ألعاب أونلاين من Serva. العب مع صحابك من المتصفح بلا تنزيل: اعمل غرفة، ابعت الكود، أو العب ضد الكمبيوتر. اجمع نقاط وتصدّر القائمة.">
  <div class="ad-wrap" data-ad="home_top" hidden></div>

  <!-- hero -->
  <section class="hero" aria-labelledby="heroTitle">
    <div class="hero-text">
      <span class="eyebrow"><Fragment set:html={ui('sparkle')} />منصة ألعاب أونلاين من Serva</span>
      <h1 id="heroTitle">العب مع صحابك…<br /><span class="grad">بلا تنزيل</span></h1>
      <p class="lead">اختار لعبة، اعمل غرفة وابعت الكود لصحابك — أو العب ضد الكمبيوتر إذا ما حدا فاضي. كل فوز بيجمعلك نقاط.</p>
      <div class="hero-cta">
        <a class="btn btn-gold big" href="/games"><Fragment set:html={icon('library')} />تصفّح مكتبة الألعاب</a>
        <button class="btn big btn-ghost" type="button" id="codeBtn"><Fragment set:html={ui('key')} />عندي كود غرفة</button>
      </div>
      <ul class="hero-facts">
        <li><Fragment set:html={ui('check')} />من المتصفح، عالموبايل والكمبيوتر</li>
        <li id="gamesFact" hidden><Fragment set:html={ui('gamepad')} /><span></span></li>
        <li id="liveFact" hidden><Fragment set:html={ui('online')} /><span></span></li>
      </ul>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="fan">
        {CATALOG.map((g, i) => (
          <span class="fan-card" data-slug={g.slug} style={`--k:${i};--ac:${g.accent}`}>
            <img src={g.art} alt="" width="480" height="300" decoding="async" fetchpriority={i === 0 ? 'high' : undefined} />
          </span>
        ))}
      </div>
    </div>
  </section>

  <div id="myCard"></div>

  <!-- featured games -->
  <section class="sec" aria-labelledby="featTitle">
    <div class="sec-head">
      <div><h2 id="featTitle"><Fragment set:html={ui('star')} />ألعاب مميّزة</h2><p>اختار وحدة وبلّش خلال ثواني.</p></div>
      <a class="sec-link" href="/games">كل الألعاب<Fragment set:html={icon('chevron')} /></a>
    </div>
    <div class="game-cards feat-row" id="featGrid">{[0, 1, 2, 3].map(() => <div class="gcard skel" aria-hidden="true"></div>)}</div>
  </section>

  <!-- live rooms + leaders -->
  <section class="sec home-split">
    <div class="panel rooms-panel" aria-labelledby="roomsTitle">
      <div id="resumeBox" hidden>
        <div class="panel-head"><h2><Fragment set:html={ui('refresh')} />كمّل من وين وقفت</h2></div>
        <div class="room-list" id="resumeList"></div>
        <hr class="split-hr" />
      </div>
      <div class="panel-head">
        <h2 id="roomsTitle"><Fragment set:html={ui('users')} />غرف مفتوحة الآن</h2>
        <span class="live-dot" title="بتتحدّث لحالها"></span>
      </div>
      <div id="roomList" class="room-list"><div class="state state-loading"><span class="spinner"></span><span>عم دوّر…</span></div></div>
    </div>

    <div class="panel leaders-panel" aria-labelledby="leadTitle">
      <div class="panel-head">
        <h2 id="leadTitle"><Fragment set:html={ui('trophy')} />المتصدرين</h2>
        <a class="sec-link" href="/leaders">الكل<Fragment set:html={icon('chevron')} /></a>
      </div>
      <ol class="mini-leaders" id="miniLeaders"><li class="state state-loading"><span class="spinner"></span><span>عم حمّل…</span></li></ol>
    </div>
  </section>

  <div class="ad-wrap" data-ad="home_bottom" hidden></div>
</Base>

<style is:global>
  /* hero */
  .hero { display: grid; grid-template-columns: 1.05fr .95fr; gap: 36px; align-items: center; padding: 34px 0 6px; }
  .hero h1 { font-size: clamp(36px, 5.4vw, 62px); font-weight: 900; margin: 18px 0 16px; letter-spacing: -.5px; line-height: 1.15; }
  .hero .grad { background: linear-gradient(90deg, var(--gold), #ffe08a 40%, var(--cyan2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .lead { color: #c3d3e6; font-size: 18px; line-height: 1.85; margin: 0 0 26px; max-width: 520px; }
  .hero-cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .hero-facts { list-style: none; padding: 0; margin: 24px 0 0; display: flex; flex-wrap: wrap; gap: 8px 22px; color: var(--muted); font-weight: 700; font-size: 14px; }
  .hero-facts li { display: inline-flex; align-items: center; gap: 7px; }
  .hero-facts .ui-ico { color: var(--cyan2); }
  #liveFact .ui-ico { color: var(--ok); }
  #liveFact span, #gamesFact span { color: var(--text); }

  /* fanned stack of game art */
  .hero-art { display: flex; justify-content: center; }
  .fan { position: relative; width: min(100%, 460px); aspect-ratio: 1.25; }
  .fan::before { content: ''; position: absolute; inset: 12% 8%; border-radius: 50%; background: radial-gradient(circle, rgba(0, 180, 255, .35), transparent 70%); filter: blur(20px); }
  .fan-card { --k: 0; position: absolute; width: 62%; aspect-ratio: 8 / 5; border-radius: 18px; overflow: hidden; left: 19%; top: 24%;
    border: 1px solid color-mix(in srgb, var(--ac) 45%, transparent); box-shadow: 0 24px 50px rgba(0, 0, 0, .55), 0 0 30px color-mix(in srgb, var(--ac) 18%, transparent);
    transition: transform .5s cubic-bezier(.2, .8, .2, 1), opacity .4s; animation: floaty 6s ease-in-out infinite; animation-delay: calc(var(--k) * -1.4s); }
  .fan-card img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fan-card[data-pos="0"] { z-index: 4; transform: translate(0, 6%) rotate(0deg) scale(1.08); }
  .fan-card[data-pos="1"] { z-index: 3; transform: translate(-38%, -22%) rotate(-9deg) scale(.86); }
  .fan-card[data-pos="2"] { z-index: 2; transform: translate(36%, -26%) rotate(8deg) scale(.82); }
  .fan-card[data-pos="3"] { z-index: 1; transform: translate(40%, 40%) rotate(10deg) scale(.74); opacity: .9; }
  .fan-card:not([data-pos]) { opacity: 0; }
  @keyframes floaty { 50% { translate: 0 -8px; } }

  /* my card */
  .my-card { margin-top: 30px; display: flex; align-items: center; gap: 14px; flex-wrap: wrap; text-decoration: none !important; color: var(--text);
    background: linear-gradient(90deg, rgba(0, 180, 255, .12), rgba(255, 197, 61, .06)); border: 1px solid rgba(47, 226, 255, .3); border-radius: 20px; padding: 14px 18px; }
  .my-card:hover { border-color: rgba(47, 226, 255, .6); }
  .my-card .who { flex: 1; min-width: 160px; }
  .my-card .who small { display: block; color: var(--muted); }
  .my-stats { display: flex; gap: 8px; flex-wrap: wrap; }
  .my-stats span { display: inline-flex; align-items: center; gap: 6px; background: rgba(3, 8, 22, .55); border: 1px solid var(--line2); border-radius: 12px; padding: 6px 12px; color: var(--muted); font-size: 13.5px; }
  .my-stats b { color: var(--gold); font-size: 16px; }
  .my-stats .ui-ico { color: var(--cyan2); }

  /* featured row */
  .feat-row { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .feat-row .gcard-top h3 { font-size: 20px; }
  .feat-row .gc-go { display: none; }

  /* rooms + leaders */
  .home-split { display: grid; grid-template-columns: 1.5fr 1fr; gap: 18px; align-items: start; }
  .split-hr { border: 0; border-top: 1px solid var(--line); margin: 18px 0; }
  .mini-leaders { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
  .ml-row { display: grid; grid-template-columns: 26px auto minmax(0, 1fr) auto; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 12px; color: var(--text); text-decoration: none !important; }
  .ml-row:hover { background: rgba(0, 180, 255, .08); }
  .ml-rank { font-weight: 900; color: var(--muted); text-align: center; }
  .ml-row:nth-child(1) .ml-rank { color: var(--gold); }
  .ml-row:nth-child(2) .ml-rank { color: #cbd5e1; }
  .ml-row:nth-child(3) .ml-rank { color: #fb923c; }
  .ml-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 800; }
  .ml-pts { display: inline-flex; align-items: center; gap: 4px; color: var(--gold); font-weight: 900; direction: ltr; }
  .ml-pts .ui-ico { width: 15px; height: 15px; }

  @media (max-width: 1020px) {
    .feat-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 960px) {
    .hero { grid-template-columns: 1fr; text-align: center; gap: 8px; padding-top: 20px; }
    .lead { margin-inline: auto; }
    .hero-cta, .hero-facts { justify-content: center; }
    .hero-art { order: -1; }
    .fan { width: min(100%, 360px); }
    .home-split { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .hero h1 { margin: 12px 0; }
    .lead { font-size: 16px; margin-bottom: 20px; }
    .hero-cta .btn { flex: 1 1 100%; }
    .hero-facts { font-size: 13px; gap: 6px 16px; }
    /* phones: featured games scroll sideways */
    .feat-row { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 12px; margin-inline: -16px; padding: 4px 16px 10px; scrollbar-width: none; }
    .feat-row::-webkit-scrollbar { display: none; }
    .feat-row .gcard { flex: 0 0 78%; scroll-snap-align: center; }
    .feat-row .gcard:hover { transform: none; }
  }
</style>

<script>
  import { $, esc, fmtN, ui, api, toast, avatarHTML, loadSession, session, mountAds, modal } from '../lib/client';
  import { liveGames, type LiveGame } from '../components/games/catalog';
  import { gameCardHTML } from '../components/games/cards';
  import { openRooms, roomItemHTML, myRooms, findRoom, roomUrl, askName, join, playError, rememberName, savedName, isTharwa, type OpenRoom } from '../components/games/play';

  let games: LiveGame[] = [];
  const bySlug = (s: string) => games.find((g) => g.slug === s);

  // ---- hero fan: only games that are in the registry
  function drawFan() {
    const cards = [...document.querySelectorAll<HTMLElement>('.fan-card')];
    const live = cards.filter((c) => games.some((g) => g.slug === c.dataset.slug));
    cards.forEach((c) => c.removeAttribute('data-pos'));
    live.forEach((c, i) => c.setAttribute('data-pos', String(i)));
  }
  // before the registry answers, show the stack as drawn (decoration only)
  document.querySelectorAll<HTMLElement>('.fan-card').forEach((c, i) => c.setAttribute('data-pos', String(i)));

  function drawGames() {
    const grid = $('#featGrid')!;
    if (!session.ok) { grid.innerHTML = `<div class="panel state state-error" style="grid-column:1/-1">${ui('warn')}<span>ما قدرنا نوصل للسيرفر — جرّب تحدّث الصفحة.</span></div>`; return; }
    if (!games.length) { grid.innerHTML = `<div class="panel state state-empty" style="grid-column:1/-1">${ui('sparkle')}<span>ما في ألعاب مفعّلة هلق.</span></div>`; return; }
    grid.innerHTML = games.slice(0, 4).map((g, i) => gameCardHTML(g, i)).join('');
    const gf = $('#gamesFact')!;
    gf.hidden = games.length < 2;
    $('span', gf)!.textContent = `${games.length} ألعاب بالمكتبة`;
    const live = games.reduce((n, g) => n + (g.live || 0), 0);
    const lf = $('#liveFact')!;
    lf.hidden = !live;
    if (live) $('span', lf)!.textContent = `${fmtN(live)} لاعب عم يلعبوا هلق`;
    drawFan();
  }

  function drawMe() {
    const me = session.me, box = $('#myCard')!;
    box.innerHTML = me ? `<a class="my-card" href="/u/${encodeURIComponent(me.username)}">${avatarHTML(me.avatar, 52, me.color)}
      <div class="who"><b>أهلين ${esc(me.displayName)}</b><small dir="ltr">@${esc(me.username)}</small></div>
      <div class="my-stats"><span>${ui('star')}<b>${fmtN(me.points)}</b> نقطة</span><span>${ui('trophy')}<b>${fmtN(me.wins)}</b> فوز</span><span>${ui('dice')}<b>${fmtN(me.games)}</b> لعبة</span></div></a>` : '';
  }

  // ---- open rooms across every game (refreshed every 5 s while the tab is visible)
  let failed = 0, lastRefresh = 0;
  async function refreshRooms() {
    if (document.hidden || !games.length) return;
    if (Date.now() - lastRefresh < 2000) return; // visibilitychange + timer can fire together
    lastRefresh = Date.now();
    const box = $('#roomList')!;
    const results = await Promise.all(games.map((g) => openRooms(g.slug).then((r) => r || [], () => null)));
    const ok = results.filter((r): r is OpenRoom[] => r !== null);
    if (!ok.length) {
      if (++failed >= 2) box.innerHTML = `<div class="state state-error">${ui('warn')}<span>ما قدرنا نجيب الغرف — عم نجرّب كمان…</span></div>`;
      return;
    }
    failed = 0;
    const all = ok.flat().sort((a, b) => b.count - a.count).slice(0, 8);
    box.innerHTML = all.length
      ? all.map((r) => { const g = bySlug(r.slug); return roomItemHTML(r, g?.name, g?.art); }).join('')
      : `<div class="room-empty">${ui('dice')}ما في غرف مفتوحة هلق — <a href="/games">اختار لعبة</a> وابدأ وحدة.</div>`;
  }

  async function drawResume() {
    const list = await myRooms(games.map((g) => g.slug)).catch(() => []);
    const box = $('#resumeBox')!;
    box.hidden = !list.length;
    $('#resumeList')!.innerHTML = list.map((r) => {
      const g = bySlug(r.slug);
      const st = r.status === 'lobby' ? 'بالانتظار' : 'اللعبة شغّالة';
      return `<div class="room-item resume">${g?.art ? `<img class="ri-art" src="${esc(g.art)}" alt="" width="48" height="30">` : ''}
        <div class="ri-text"><b>${esc(g?.name || r.slug)}</b><small><span class="ltr">${esc(r.code)}</span><i class="dot-sep"></i>${st}</small></div>
        <a class="btn btn-cyan sm" href="${esc(roomUrl(r.slug, r.code))}">${ui('play')}كمّل</a></div>`;
    }).join('');
  }

  // ---- entering a room from a list
  async function enter(slug: string, code: string, btn: HTMLButtonElement) {
    if (isTharwa(slug)) { const n = savedName(); if (n) rememberName(n); location.href = roomUrl(slug, code); return; }
    const name = await askName();
    if (!name) return;
    btn.disabled = true; btn.classList.add('loading');
    try { location.href = await join(slug, code, name); }
    catch (e) { toast(playError(e, slug, true)); btn.disabled = false; btn.classList.remove('loading'); }
  }
  $('#roomList')!.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('[data-room]');
    if (b) enter(b.dataset.slug || 'tharwa', b.dataset.room || '', b);
  });

  // ---- «عندي كود غرفة»: works for any game (ثروة codes are checked first, then the other games' open rooms)
  $('#codeBtn')!.addEventListener('click', () => {
    const m = modal('ادخل بكود الغرفة', `<form id="codeForm" class="name-form">
      <p class="modal-text" style="margin:0">صاحبك بعتلك كود؟ اكتبه هون وبندخّلك عالغرفة.</p>
      <input class="input ltr" id="codeIn" maxlength="8" placeholder="abc12" autocomplete="off" autocapitalize="off" spellcheck="false" style="text-align:center;font-weight:800;letter-spacing:3px;font-size:18px">
      <button class="btn btn-gold block" type="submit" id="codeGo">${ui('key')}ادخل</button></form>`);
    const input = $('#codeIn', m.root) as HTMLInputElement, go = $('#codeGo', m.root) as HTMLButtonElement;
    input.focus();
    input.addEventListener('input', () => { input.value = input.value.replace(/[^A-Za-z0-9]/g, ''); });
    $('#codeForm', m.root)!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const code = input.value.trim();
      if (code.length < 4) { toast('اكتب كود الغرفة'); input.focus(); return; }
      go.disabled = true; go.classList.add('loading');
      try {
        const hit = await findRoom(code, games.map((g) => g.slug));
        if (hit && isTharwa(hit.slug)) { location.href = roomUrl('tharwa', hit.code); return; }
        if (hit) {
          m.close();
          // a game that already started can only be watched: the room page handles spectators
          if (hit.status !== 'lobby') { location.href = roomUrl(hit.slug, hit.code); return; }
          const name = await askName();
          if (!name) return;
          location.href = await join(hit.slug, hit.code, name);
          return;
        }
        toast('ما لقينا غرفة مفتوحة بهالكود — تأكّد منه');
      } catch (err) { toast(playError(err, 'g', true)); }
      go.disabled = false; go.classList.remove('loading');
    });
  });

  // ---- leaders (top 5)
  async function drawLeaders() {
    const box = $('#miniLeaders')!;
    try {
      const list = await api<{ username: string; displayName: string; avatar: string; color: string | null; points: number }[]>('/api/leaders');
      box.innerHTML = list.length
        ? list.slice(0, 5).map((u, i) => `<li><a class="ml-row" href="/u/${encodeURIComponent(u.username)}"><span class="ml-rank">${i + 1}</span>${avatarHTML(u.avatar, 34, u.color)}
            <span class="ml-name">${esc(u.displayName)}</span><span class="ml-pts">${ui('star')}${fmtN(u.points)}</span></a></li>`).join('')
        : `<li class="room-empty">${ui('trophy')}لسا ما حدا عالقائمة — كون أول واحد!</li>`;
    } catch {
      box.innerHTML = `<li class="state state-error">${ui('warn')}<span>ما قدرنا نجيب القائمة</span></li>`;
    }
  }

  loadSession().then(() => {
    games = liveGames(session.site.games);
    drawGames(); drawMe(); mountAds();
    refreshRooms(); drawResume();
    setInterval(refreshRooms, 5000);
    document.addEventListener('visibilitychange', refreshRooms);
  });
  drawLeaders();
</script>
