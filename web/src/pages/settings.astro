---
import Base from '../layouts/Base.astro';
import { ui } from '../lib/art-build';
const G_LOGO = '<svg class="g-logo" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>';
const SECTIONS = [
  ['sProfile', 'user', 'الملف الشخصي'],
  ['sEmail', 'mail', 'الإيميل'],
  ['sUser', 'tag', 'اسم المستخدم'],
  ['sGoogle', 'link', 'حساب Google'],
  ['sPass', 'key', 'كلمة السر'],
  ['sDel', 'trash', 'حذف الحساب'],
];
---
<Base title="الإعدادات" description="إعدادات حسابك على Serva Games." noindex canonical={false}>
  <h1 class="page-title"><Fragment set:html={ui('gear')} />إعدادات الحساب</h1>
  <div class="settings" id="settings">
    <nav class="set-nav panel" aria-label="أقسام الإعدادات">
      {SECTIONS.map(([id, ic, t]) => <a href={`#${id}`}><Fragment set:html={id === 'sGoogle' ? G_LOGO : ui(ic)} /><span>{t}</span></a>)}
    </nav>
    <div class="set-body" id="setBody">
      <div class="panel"><div class="state state-loading"><span class="spinner"></span><span>عم حمّل…</span></div></div>
    </div>
  </div>
  <template id="gLogo"><Fragment set:html={G_LOGO} /></template>
</Base>

<style is:global>
  .settings { display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: 20px; align-items: start; margin-top: 18px; }
  .set-nav { position: sticky; top: calc(var(--hdr) + 16px); display: flex; flex-direction: column; gap: 2px; padding: 8px; }
  .set-nav a { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 11px; color: var(--muted); font-weight: 800; text-decoration: none !important; }
  .set-nav a:hover { background: var(--panel2); color: var(--text); }
  .set-nav a .ui-ico { color: var(--cyan2); }
  .set-nav .g-logo { width: 18px; height: 18px; }
  .set-body { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .set-sec h2 { font-size: 18px; font-weight: 900; display: flex; align-items: center; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; }
  .set-sec h2 > .ui-ico { color: var(--cyan2); }
  .set-sec h2 .g-logo { width: 20px; height: 20px; }
  .set-sec > p { color: var(--muted); margin: -6px 0 14px; }
  .set-head { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; padding: 12px; border-radius: 14px; background: rgba(7, 16, 42, .7); border: 1px solid var(--line); }
  .set-head b { display: block; font-size: 17px; }
  .set-head .handle { color: var(--cyan2); font-weight: 800; }
  .set-head a { font-size: 13.5px; }
  .ava-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(56px, 1fr)); gap: 8px; }
  .ava-pick, .sw-pick, .pc-pick { background: rgba(7, 16, 42, .9); border: 2px solid transparent; border-radius: 14px; padding: 4px; cursor: pointer; display: flex; align-items: center; justify-content: center; color: var(--text); transition: border-color .15s; }
  .ava-pick:hover, .sw-pick:hover, .pc-pick:hover { border-color: var(--line2); }
  .ava-pick.on, .sw-pick.on, .pc-pick.on { border-color: var(--gold); box-shadow: 0 0 12px rgba(255, 197, 61, .4); }
  .pick-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .sw-pick { min-width: 42px; height: 42px; padding: 0 12px; font-weight: 800; font-size: 12.5px; }
  .sw-pick.sw { width: 42px; padding: 0; background: var(--c); }
  .pc-pick { width: 48px; height: 48px; }
  .pc-pick .tk { width: 36px; height: 36px; }
  .pc-pick.auto { width: auto; padding: 0 12px; font-weight: 800; font-size: 12.5px; }
  .nudge { background: rgba(255, 197, 61, .08); border: 1px dashed rgba(255, 197, 61, .45); border-radius: 12px; padding: 10px 12px; margin-bottom: 14px; color: #ffe6a8; }
  .g-linked { display: flex; align-items: center; gap: 8px; color: var(--ok); font-weight: 800; margin: 0; }
  .btn-google { display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 10px 16px; border-radius: 12px; background: #fff; color: #1f1f1f !important; font-weight: 800; text-decoration: none !important; border: 1px solid #dadce0; }
  .g-logo { width: 20px; height: 20px; flex: 0 0 auto; }
  .danger-zone { border-color: rgba(255, 107, 122, .4); background: linear-gradient(180deg, rgba(255, 107, 122, .06), rgba(10, 21, 48, .85)); }
  .danger-zone h2 > .ui-ico { color: var(--danger); }
  .set-sec .actions { display: flex; gap: 10px; flex-wrap: wrap; }
  @media (max-width: 860px) {
    .settings { grid-template-columns: 1fr; }
    .set-nav { position: static; flex-direction: row; overflow-x: auto; scrollbar-width: none; }
    .set-nav a { white-space: nowrap; }
  }
</style>

<script>
  import { $, $$, esc, ui, api, toast, showErr, busy, confirmBox, avatarHTML, loadSession, session, setMe, COLORS, USER_RE, EMAIL_RE, type Me } from '../lib/client';
  const G_LOGO = ($('#gLogo') as HTMLTemplateElement).innerHTML;
  const body = $('#setBody')!;

  function render() {
    const me = session.me as Me;
    const ART = window.ART;
    const avatars = [...ART.AVATAR_KEYS, ...ART.PIECE_KEYS.map((k) => 'piece:' + k)];
    if (/^https:/.test(me.avatar)) avatars.unshift(me.avatar); // Google photo stays selectable
    body.innerHTML = `
      <form class="panel set-sec" id="sProfile" novalidate>
        <h2>${ui('user')}الملف الشخصي</h2>
        <div class="set-head">${avatarHTML(me.avatar, 72, me.color)}<div><b class="dn"></b><div class="handle" dir="ltr">@${esc(me.username)}</div><a href="/u/${encodeURIComponent(me.username)}">شوف بروفايلك ←</a></div></div>
        <label class="field"><span>الاسم الظاهر</span><input name="displayName" maxlength="24" value="${esc(me.displayName)}" required></label>
        <label class="field"><span>نبذة عنك <small class="muted" id="bioCount"></small></span><textarea name="bio" maxlength="160" rows="3" placeholder="شي قصير عنك…">${esc(me.bio)}</textarea></label>
        <div class="field"><span class="field-label">الصورة</span><div class="ava-grid" role="radiogroup" aria-label="الصورة">${avatars.map((k) => `<button type="button" role="radio" aria-checked="${k === me.avatar}" class="ava-pick ${k === me.avatar ? 'on' : ''}" data-ava="${esc(k)}" aria-label="${k.startsWith('piece:') ? esc(ART.pieceLabel(k.slice(6))) : /^https:/.test(k) ? 'صورة Google' : 'صورة ' + esc(k.slice(1))}">${avatarHTML(k, 46, me.color)}</button>`).join('')}</div></div>
        <div class="field"><span class="field-label">لونك باللعبة</span><div class="pick-row" role="radiogroup" aria-label="لونك باللعبة"><button type="button" role="radio" aria-checked="${!me.color}" class="sw-pick ${!me.color ? 'on' : ''}" data-color="">تلقائي</button>${COLORS.map((c) => `<button type="button" role="radio" aria-checked="${me.color === c}" class="sw-pick sw ${me.color === c ? 'on' : ''}" data-color="${c}" style="--c:${c}" aria-label="${c}"></button>`).join('')}</div></div>
        <div class="field"><span class="field-label">قطعتك المفضّلة</span><div class="pick-row" role="radiogroup" aria-label="قطعتك المفضّلة"><button type="button" role="radio" aria-checked="${!me.piece}" class="pc-pick auto ${!me.piece ? 'on' : ''}" data-piece="">تلقائي</button>${ART.PIECE_KEYS.map((k) => `<button type="button" role="radio" aria-checked="${me.piece === k}" class="pc-pick ${me.piece === k ? 'on' : ''}" data-piece="${k}" title="${esc(ART.pieceLabel(k))}" aria-label="${esc(ART.pieceLabel(k))}"><span class="tk" style="--pc:${esc(me.color || '#00b4ff')}">${ART.piece(k)}</span></button>`).join('')}</div></div>
        <div class="form-err" id="profErr" role="alert"></div>
        <button class="btn btn-gold" id="profSave">${ui('check')}حفظ التغييرات</button>
      </form>

      <form class="panel set-sec" id="sEmail" novalidate>
        <h2>${ui('mail')}الإيميل ${me.email ? (me.emailVerified ? '<span class="badge green">مؤكَّد</span>' : '<span class="badge">مو مؤكَّد</span>') : ''}</h2>
        ${me.email ? '' : '<div class="nudge">ضيف إيميلك لحماية حسابك — بيساعدك ترجع لحسابك وتربطه بـ Google.</div>'}
        <label class="field"><span>الإيميل</span><input name="email" type="email" dir="ltr" maxlength="254" value="${esc(me.email || '')}" placeholder="name@gmail.com" autocomplete="email"></label>
        ${me.hasPassword ? '<label class="field"><span>كلمة السر الحالية (للتأكيد)</span><input name="password" type="password" autocomplete="current-password" dir="ltr"></label>' : ''}
        <div class="form-err" id="emailErr" role="alert"></div>
        <button class="btn">${me.email ? 'غيّر الإيميل' : 'ضيف الإيميل'}</button>
      </form>

      <form class="panel set-sec" id="sUser" novalidate>
        <h2>${ui('tag')}اسم المستخدم</h2>
        <p>رابط بروفايلك: <b dir="ltr">/u/${esc(me.username)}</b> — فيك تغيّره مرة كل 30 يوم.</p>
        <label class="field"><span>اسم المستخدم الجديد</span><input name="username" dir="ltr" maxlength="20" value="${esc(me.username)}" autocomplete="off"></label>
        <div class="form-err" id="userErr" role="alert"></div>
        <button class="btn">غيّر اسم المستخدم</button>
      </form>

      <section class="panel set-sec" id="sGoogle">
        <h2>${G_LOGO}حساب Google</h2>
        ${me.google ? `<p class="g-linked">${ui('check')}مربوط بـ Google — فيك تدخل بكبسة وحدة.</p>`
          : session.site.googleEnabled ? `<p>اربط حسابك بـ Google لتدخل بكبسة وحدة بدون كلمة سر.</p><a class="btn-google" href="/api/auth/google/start?link=1">${G_LOGO}<span>ربط حساب Google</span></a>`
            : '<p class="muted" style="margin:0">الدخول بـ Google مو مفعّل هلق.</p>'}
      </section>

      <form class="panel set-sec" id="sPass" novalidate>
        <h2>${ui('key')}${me.hasPassword ? 'تغيير كلمة السر' : 'حط كلمة سر'}</h2>
        ${me.hasPassword ? '<label class="field"><span>كلمة السر الحالية</span><input name="current" type="password" autocomplete="current-password" dir="ltr"></label>'
          : '<p>حسابك بيدخل بـ Google بس. إذا حطيت كلمة سر، بتقدر تدخل كمان بالإيميل أو اسم المستخدم.</p>'}
        <label class="field"><span>كلمة السر الجديدة</span><input name="next" type="password" autocomplete="new-password" dir="ltr"><small class="fhint">6 أحرف على الأقل</small></label>
        <div class="form-err" id="passErr" role="alert"></div>
        <button class="btn">${me.hasPassword ? 'غيّر كلمة السر' : 'حط كلمة السر'}</button>
      </form>

      <form class="panel set-sec danger-zone" id="sDel" novalidate>
        <h2>${ui('trash')}حذف الحساب</h2>
        <p>رح ينمسح حسابك ونقاطك نهائياً. ما في رجعة.</p>
        <label class="field"><span>${me.hasPassword ? 'اكتب كلمة السر للتأكيد' : 'اكتب اسم المستخدم تبعك للتأكيد'}</span><input name="password" type="${me.hasPassword ? 'password' : 'text'}" dir="ltr" autocomplete="${me.hasPassword ? 'current-password' : 'off'}"></label>
        <div class="form-err" id="delErr" role="alert"></div>
        <button class="btn btn-danger">${ui('trash')}احذف حسابي نهائياً</button>
      </form>`;
    $('.dn', body)!.textContent = me.displayName;
    bind(me);
  }

  const field = (f: HTMLFormElement, n: string) => f.elements.namedItem(n) as HTMLInputElement | null;
  const refresh = (user: Me) => { setMe(user); render(); };

  function bind(me: Me) {
    // ---- profile
    const fp = $('#sProfile') as HTMLFormElement;
    const sel: { avatar: string; color: string | null; piece: string | null } = { avatar: me.avatar, color: me.color || null, piece: me.piece || null };
    const bio = field(fp, 'bio') as unknown as HTMLTextAreaElement;
    const count = () => { $('#bioCount')!.textContent = `(${[...bio.value].length}/160)`; };
    bio.addEventListener('input', count); count();
    const pick = (attr: string, key: 'avatar' | 'color' | 'piece') => {
      const list = $$<HTMLButtonElement>(`[data-${attr}]`, fp);
      list.forEach((b) => b.addEventListener('click', () => {
        (sel as any)[key] = b.getAttribute('data-' + attr) || null;
        list.forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-checked', String(x === b)); });
        // The chosen colour also tints the piece previews.
        if (key === 'color') $$<HTMLElement>('.pc-pick .tk, .ava.piece', fp).forEach((t) => t.style.setProperty('--pc', sel.color || '#00b4ff'));
      }));
    };
    pick('ava', 'avatar'); pick('color', 'color'); pick('piece', 'piece');
    fp.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = $('#profSave') as HTMLButtonElement, err = $('#profErr');
      showErr(err, '');
      const dn = field(fp, 'displayName')!.value;
      if (!dn.trim()) { showErr(err, 'الاسم ما فيه يكون فاضي'); return; }
      busy(btn, true, 'عم احفظ…');
      try {
        const r = await api<{ user: Me }>('/api/me/update', { displayName: dn, bio: bio.value, avatar: sel.avatar, color: sel.color, piece: sel.piece });
        toast('انحفظ', 'ok'); refresh(r.user);
      } catch (x) { showErr(err, (x as Error).message); busy(btn, false); }
    });

    // ---- email
    const fe = $('#sEmail') as HTMLFormElement;
    fe.addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = $('#emailErr'), email = field(fe, 'email')!.value.trim().toLowerCase();
      showErr(err, '');
      if (!EMAIL_RE.test(email)) { showErr(err, 'الإيميل مو صحيح — مثلاً: name@gmail.com'); return; }
      const btn = fe.querySelector('button') as HTMLButtonElement;
      busy(btn, true, 'لحظة…');
      try { const r = await api<{ user: Me }>('/api/me/update', { email, password: field(fe, 'password')?.value || '' }); toast('انحفظ الإيميل', 'ok'); refresh(r.user); }
      catch (x) { showErr(err, (x as Error).message); busy(btn, false); }
    });

    // ---- username
    const fu = $('#sUser') as HTMLFormElement, un = field(fu, 'username')!;
    un.addEventListener('input', () => { un.value = un.value.toLowerCase().replace(/\s/g, ''); });
    fu.addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = $('#userErr'), v = un.value.trim().toLowerCase();
      showErr(err, '');
      if (!USER_RE.test(v)) { showErr(err, 'اسم المستخدم لازم يكون 3–20 حرف إنكليزي صغير أو رقم أو _'); return; }
      if (v === me.username) { showErr(err, 'هاد اسمك الحالي'); return; }
      if (!(await confirmBox(`رابط بروفايلك رح يصير /u/${v} والرابط القديم بيبطل. متأكد؟`, 'غيّر'))) return;
      try { const r = await api<{ user: Me }>('/api/me/username', { username: v }); toast('تغيّر اسم المستخدم', 'ok'); refresh(r.user); }
      catch (x) { showErr(err, (x as Error).message); }
    });

    // ---- password
    const fpw = $('#sPass') as HTMLFormElement;
    fpw.addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = $('#passErr'), nx = field(fpw, 'next')!.value;
      showErr(err, '');
      if (nx.length < 6) { showErr(err, 'كلمة السر الجديدة لازم تكون 6 أحرف على الأقل'); return; }
      const btn = fpw.querySelector('button') as HTMLButtonElement;
      busy(btn, true, 'لحظة…');
      try {
        await api('/api/me/password', { current: field(fpw, 'current')?.value || '', next: nx });
        toast(me.hasPassword ? 'تغيّرت كلمة السر' : 'صار عندك كلمة سر', 'ok');
        const r = await api<{ user: Me | null }>('/api/auth/me');
        if (r.user) refresh(r.user);
      } catch (x) { showErr(err, (x as Error).message); busy(btn, false); }
    });

    // ---- delete
    const fd = $('#sDel') as HTMLFormElement;
    fd.addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = $('#delErr');
      showErr(err, '');
      if (!(await confirmBox('أكيد بدك تحذف حسابك نهائياً؟', 'احذف'))) return;
      try { await api('/api/me/delete', { password: field(fd, 'password')!.value }); location.href = '/'; }
      catch (x) { showErr(err, (x as Error).message); }
    });
  }

  loadSession().then(() => {
    if (!session.me) { location.replace('/login?next=/settings'); return; }
    const qs = new URLSearchParams(location.search);
    if (qs.get('glinked')) { toast('انربط حسابك بـ Google', 'ok'); history.replaceState(null, '', '/settings'); }
    if (qs.get('gerr')) { toast('حساب Google هاد مربوط بحساب تاني'); history.replaceState(null, '', '/settings'); }
    render();
  });
</script>
