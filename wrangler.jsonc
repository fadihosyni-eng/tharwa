// Cloudflare Workers config for «ثروة» (see worker.js for how requests flow).
// Local:  npx wrangler dev        (put STORE=memory in .dev.vars — never the real database)
// Deploy: npx wrangler deploy     (secrets: npx wrangler secret put DATABASE_URL, …)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tharwa",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // The bundle is an ES module, which has no __dirname; server.js / store.js only use it to build
  // file paths that are never read on Cloudflare (static files come from "assets").
  "define": { "__dirname": "\"/bundle\"" },

  // Site files: web/site = old client (public/, index.html renamed game.html) + the new Astro pages on top.
  // Built by the "build" command below on every deploy. /room/* and /u/* are rewritten in worker.js.
  "build": { "command": "npm --prefix web run build && npm --prefix web run assemble" },
  "assets": {
    "directory": "./web/site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/room/*", "/u/*", "/admin", "/admin/"]
  },

  // One Durable Object («main») runs the whole game server. SQLite-backed class = allowed on the Free plan.
  "durable_objects": {
    "bindings": [{ "name": "THARWA", "class_name": "Tharwa" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Tharwa"] }],

  // Live address: serva-g.com. game.serva-g.com and www are sent here by cf-redirect/ (a separate tiny Worker).
  "workers_dev": false,
  "routes": [{ "pattern": "serva-g.com", "custom_domain": true }],
  "vars": {
    "PUBLIC_URL": "https://serva-g.com",
    // Google sign-in client (project tharwa-514918). The ID is public; GOOGLE_CLIENT_SECRET is a Worker secret.
    "GOOGLE_CLIENT_ID": "411563134145-4g6frfukb9vvulcvn59m08304q3stnnl.apps.googleusercontent.com"
  },

  // Supabase through Hyperdrive «tharwa-db» (caching off). A Worker can't verify Supabase's own TLS CA,
  // so a direct pg connection is cut during the handshake; worker.js uses env.HYPERDRIVE when present.
  // localConnectionString only keeps `wrangler dev` happy — local dev runs with STORE=memory and never uses it.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "7144adb82d5d413cb2199890f6d13b10", "localConnectionString": "postgres://dev:dev@localhost:5432/dev" }],

  // Version id → a fresh game-server Durable Object per deploy (see worker.js).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  "observability": { "enabled": true, "logs": { "enabled": true } }
}
